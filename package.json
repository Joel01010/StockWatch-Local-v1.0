{
  "name": "stockwatch-local",
  "private": true,
  "version": "1.0.0-rc.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "check:phase0": "node tools/phase0-check.mjs",
    "test": "node --test tests/*.test.mjs",
    "check:phase1": "node tools/phase1-check.mjs",
    "check:db": "python3 tools/phase1-db-check.py",
    "check:phase2": "node tools/phase2-check.mjs",
    "test:tray": "node --test tests/tray_reference.test.mjs",
    "check:phase3": "node tools/phase3-check.mjs",
    "test:dashboard": "node --test tests/dashboard_reference.test.mjs",
    "check:phase4": "node tools/phase4-check.mjs",
    "check:db4": "python3 tools/phase4-db-check.py",
    "test:market": "node --test tests/market_reference.test.mjs",
    "check:phase5": "node tools/phase5-check.mjs",
    "check:db5": "python3 tools/phase5-db-check.py",
    "test:alerts": "node --test tests/alerts_reference.test.mjs",
    "check:tscore": "tsc --noEmit --strict --target ES2022 --module ESNext --moduleResolution bundler src/lib/models.ts src/lib/demo.ts src/lib/format.ts src/lib/routing.ts",
    "check:phase6": "node tools/phase6-check.mjs",
    "check:db6": "python3 tools/phase6-db-check.py",
    "test:analytics": "node --test tests/analytics_reference.test.mjs",
    "check:tsbridge": "tsc --noEmit --strict --target ES2022 --module ESNext --moduleResolution bundler tools/tauri-shim.d.ts src/lib/models.ts src/lib/demo.ts src/lib/format.ts src/lib/routing.ts src/lib/bridge.ts",
    "check:phase7": "node tools/phase7-check.mjs",
    "check:db7": "python3 tools/phase7-db-check.py",
    "test:reliability": "node --test tests/reliability_reference.test.mjs",
    "soak:phase7": "python3 tools/phase7-soak.py",
    "check:phase8": "node tools/phase8-check.mjs",
    "test:release": "node --test tests/release_reference.test.mjs",
    "check:harness": "node tools/test-harness-check.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0"
  }
}
